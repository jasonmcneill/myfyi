{
  "name": "myfyi",
  "version": "0.1.0",
  "description": "My FYI - Electronic Business Card Platform",
  "main": "app/server.js",
  "scripts": {
    "start": "node app/server.js",
    "dev": "nodemon app/server.js",
    "dev:webhooks": "concurrently \"nodemon app/server.js\" \"stripe listen --forward-to localhost:3000/api/auth/webhook/stripe\"",
    "kill": "pkill -f 'node app/server.js' && pkill -f nodemon && pkill -f stripe",
    "migrate": "node scripts/migrate.js",
    "seed": "node seeds/index.js",
    "build:css": "tailwindcss -i ./app/public/css/input.css -o ./app/public/css/tailwind.v1.css",
    "watch:css": "tailwindcss -i ./app/public/css/input.css -o ./app/public/css/tailwind.v1.css --watch",
    "ssh:prod": "ssh root@172.236.250.102 -i ~/.ssh/usd21/id_rsa"
  },
  "keywords": [
    "business card",
    "digital card",
    "subscription"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-validator": "^7.0.0",
    "jsonwebtoken": "^9.0.0",
    "mysql2": "^3.2.0",
    "stripe": "^22.0.2",
    "nodemailer": "^6.9.1",
    "node-cron": "^3.0.2",
    "uuid": "^9.0.0",
    "helmet": "^7.0.0",
    "cors": "^2.8.5",
    "ejs": "^3.1.8"
  },
  "devDependencies": {
    "nodemon": "^2.0.22",
    "tailwindcss": "^3.3.0",
    "postcss": "^8.4.24",
    "autoprefixer": "^10.4.14",
    "concurrently": "^8.2.0"
  }
}
